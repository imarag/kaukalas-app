---
import NavBar from "../components/root/NavBar.astro";
import Footer from "../components/root/Footer.astro";
import Head from "../components/root/Head.astro";

import "@fontsource-variable/roboto";
import "../styles/style.css";

const { lang } = Astro.props;

const { pageTitle } = Astro.props;
---

<!doctype html>
<html
  lang={lang}
  data-theme="synthwave"
  class="font-display text-base text-white font-normal"
>
  <head>
    <Head pageTitle={pageTitle} />
  </head>
  <body>
    <header>
      <NavBar lang={lang} />
    </header>
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script type="module" src="/src/scripts/cookieconsent-config.js"></script>
  </body>
</html>
