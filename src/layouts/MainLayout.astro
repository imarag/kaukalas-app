---
import NavBar from "../components/root/NavBar.astro";
import Footer from "../components/root/Footer.astro";
import Head from "../components/root/Head.astro";

import "../styles/style.css";
import "@fontsource-variable/roboto-flex";

const { lang } = Astro.props;

const { pageTitle } = Astro.props;
---

<!doctype html>
<html
  lang={lang}
  data-theme="synthwave"
  class="font-display text-base text-white font-normal"
>
  <head>
    <Head pageTitle={pageTitle} />
  </head>
  <body>
    <header>
      <NavBar lang={lang} />
    </header>
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-TMERB1LXGL"
></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-TMERB1LXGL");
</script>
