---
import { languages } from "../../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";
---

<ul class="flex flex-row items-center gap-2">
  <li class="rounded-md hover:bg-primary/80">
    <a
      class="text-sm inline-block size-full p-2"
      href={getRelativeLocaleUrl("gr")}
    >
      {languages["gr"]}
    </a>
  </li>
  <li>|</li>
  <li class="rounded-md hover:bg-primary/80">
    <a
      class="text-sm inline-block size-full p-2"
      href={getRelativeLocaleUrl("en")}
    >
      {languages["en"]}
    </a>
  </li>
</ul>
