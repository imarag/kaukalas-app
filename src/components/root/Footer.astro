---
import navLinks from "../../data/nav-links";
import Logo from "../utils/Logo.astro";
import socialMedia from "../../data/social-media";
import Symbol from "../utils/Symbol.astro";
const { lang } = Astro.props;
import { getRelativeLocaleUrl } from "astro:i18n";
---

<footer
  class="text-white/90 bg-base-300 text-sm p-8 flex flex-col items-center gap-6"
>
  <Logo />
  <nav class="grid grid-cols-1 sm:grid-flow-col text-center gap-4">
    {
      navLinks.map((el) => (
        <a href={getRelativeLocaleUrl(lang, el.href)} class="link link-hover">
          {el.name[lang]}
        </a>
      ))
    }
  </nav>
  <div class="flex items-center gap-2">
    {
      socialMedia.map((el) => (
        <a
          href={el.link}
          class="inline-flex gap-2 items-center"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Go to ${el.name}`}
        >
          <Symbol name={el.icon} />
        </a>
      ))
    }
  </div>

  <aside class="flex flex-col items-center gap-2 italic text-sm">
    <p class="text-center">© 2025 GK Pool & Villas Services</p>
    <p class="text-center">
      Developed and maintained by <a
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Go to Ioannis Maragkakis Linkedin page`}
        class="link link-info"
        href="https://www.linkedin.com/in/ioannis-maragkakis-1ba2851a9"
        >Ioannis Maragkakis</a
      >
    </p>
  </aside>
</footer>
