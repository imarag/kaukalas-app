---
const baseClass = "inline-flex items-center gap-2 group";
const linkVariants = {
  button: "btn btn-primary text-white",
  ghost: "btn btn-ghost",
  outline: "btn btn-outline btn-primary",
  link: "text-primary underline hover:no-underline",
};

const { variant = "link", href = "#", ...attrs } = Astro.props;
---

<a href={href} class={`${baseClass} ${linkVariants[variant]}`} {...attrs}>
  <slot />
</a>
